# systemd unit — imfid (loyalty program), port 8060, H2 FILE database.
[Unit]
Description=imfid (Quarkus) - qualification
After=network.target

[Service]
User=apps
WorkingDirectory=/opt/apps/imfid
ExecStart=/usr/bin/java -jar /opt/apps/imfid/quarkus-app/quarkus-run.jar
Restart=on-failure
RestartSec=5
# Demonstrator profile: the seeded loyalty dataset (program zone included),
# known accounts, no imposed password change. A real loyalty service runs
# %prod on PostgreSQL; here the four applications are uniform on H2 file.
Environment=QUARKUS_PROFILE=demo
Environment=QUARKUS_HTTP_PORT=8060
Environment=QUARKUS_DATASOURCE_JDBC_URL=jdbc:h2:file:/opt/apps/imfid/data/imfid
Environment=QUARKUS_HTTP_PROXY_PROXY_ADDRESS_FORWARDING=true
# Every password-reset mail is written to the journal instead of being sent.
Environment=QUARKUS_MAILER_MOCK_EMAIL=true

[Install]
WantedBy=multi-user.target
